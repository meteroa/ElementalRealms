{
  "appId": "com.elementalrealms.game",
  "productName": "元素秘境 - 魔导对决",
  "copyright": "Copyright © 2026 Elemental Realms",
  "directories": {
    "output": "../release_pc"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "public/**/*",
    "package.json"
  ],
  "extraMetadata": {
    "main": "electron/main.cjs"
  },
  "win": {
    "signAndEditExecutable": false,
    "target": [
      {
        "target": "dir",
        "arch": ["x64"]
      },
      {
        "target": "zip",
        "arch": ["x64"]
      }
    ],
    "icon": "public/icons/icon-512.png",
    "artifactName": "ElementalRealms_v${version}_setup.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "元素秘境 - 魔导对决"
  }
}
